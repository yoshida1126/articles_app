<li id="article-<%= article.id %>">
  <%= link_to article do %>
    <span class="heading-image">
      <% if article.image.attached? %> 
        <%= image_tag article.image %>
      <% else %> 
        <div class="no-heading-image">
          <p>Articles</p>
        </div>
      <% end %>
    </span>
  <% end %>
    <div class="public-article-info">
      <span class="public-title">
        <%= link_to article do %>
          <%= article.title %>
        <% end %>
      </span>
      <div class="timestamp-and-likes">
        <span class="timestamp"> 
          <%= article.created_at.strftime("%Y年%-m月%-d日 %H:%M") %>
        </span>
        <span class="likes_btn_<%= article.id %>">
          <%= render "likes/btn", article: article %>
        </span>
      </div>
    </div>
</li>
