<li id="draft-<%= draft.id %>"> 
  <span class="heading-image">
      <% if draft.image.attached? %> 
        <%= image_tag draft.image %>
      <% else %> 
        <div class="no-heading-image">
          <p>Articles</p>
        </div>
      <% end %>
  </span>
  <div class="draft-info">
    <span class="draft-title">
        <% if draft.title == '' || draft.title.nil? %>
          タイトル未定
        <% else %>
          <%= draft.title %>
        <% end %>
    </span>
    <div class="timestamp">
      <span>
        <%= draft.created_at.strftime("%Y年%-m月%-d日 %H:%M") %>
      </span>
    </div>
  </div>
  <%= link_to preview_user_article_draft_path(current_user, draft), class: 'article-link' do %><% end %>
</li>
