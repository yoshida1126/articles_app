<% if list.articles.present? && list.articles.first.image.attached? %>
  <li>
    <span class="heading-image">
      <%= link_to user_favorite_article_list_path(@user, list) do %>
        <%= image_tag list.articles.first.image %>
      <% end %>
    </span>
    <div class="list-info">
      <div class="list-title">
        <%= link_to list.list_title, user_favorite_article_list_path(@user, list) %> 
      </div>
      <div class="timestamp-and-bookmark">
        <span class="timestamp">
          <%= list.created_at.strftime("%Y年%-m月%-d日 %H:%M") %>
        </span>
        <% if current_user and list.user != current_user %>
          <span class="bookmark-<%= list.id %>">
            <%= render "favorite_list_bookmarks/bookmark", list: list %>
          </span>
        <% end %>
      </div>
    </div>
  </li>
<% else %>
  <li>
    <span class="heading-image">
      <%= link_to user_favorite_article_list_path(@user, list) do %>
        <div class="no-heading-image">
          <p>Articles</p>
        </div>
      <% end %>
    </span>
    <div class="list-info">
      <div class="list-title">
        <%= link_to list.list_title, user_favorite_article_list_path(@user, list) %> 
      </div>
      <div class="timestamp-and-bookmark">
        <span class="timestamp">
          <%= list.created_at.strftime("%Y年%-m月%-d日 %H:%M") %>
        </span>
        <% if current_user and list.user != current_user %>
          <span class="bookmark-<%= list.id %>">
            <%= render "favorite_list_bookmarks/bookmark", list: list %>
          </span>
        <% end %>
      </div>
    </div>
  </li>
<% end %>
